---
import Layout from '@layouts/Layout.astro';
import {
  getCatalogResources,
  getResourceCatalog,
} from '../data/resources/catalogs';
import { siteContexts } from '../data/site-contexts';

const contexts = siteContexts.map((context) => {
  const catalog = getResourceCatalog(context.catalogSlug);
  if (!catalog) {
    throw new Error(
      `Site context ${context.slug} references unknown catalog ${context.catalogSlug}`,
    );
  }

  return {
    ...context,
    resourceCount: getCatalogResources(catalog).length,
  };
});
---

<Layout
  title="With Agents — Practical engineering context"
  description="Source-backed field guides and reviewed resource collections for coding with agents, cloud engineering, and security."
  canonicalPath="/"
>
  <div class="mx-auto max-w-5xl space-y-20">
    <section class="max-w-4xl space-y-8">
      <p class="text-sm font-medium uppercase tracking-[0.25em] text-indigo-600">
        Practical engineering context
      </p>
      <div class="space-y-6">
        <h1 class="text-5xl font-light leading-tight text-gray-950 md:text-6xl">
          Build, operate, and protect software with better context.
        </h1>
        <p class="max-w-3xl text-xl font-light leading-relaxed text-gray-600 md:text-2xl">
          With Agents pairs practical field guides with carefully reviewed
          resource collections for coding with agents, cloud engineering, and
          security.
        </p>
      </div>
    </section>

    <section aria-labelledby="contexts-heading" class="space-y-6">
      <div class="space-y-3">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-indigo-600">
          Choose a context
        </p>
        <h2 id="contexts-heading" class="text-3xl font-light text-gray-900">
          Start with the work in front of you.
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          contexts.map((context) => (
            <a
              href={`/${context.slug}`}
              class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 transition-all duration-200 hover:border-gray-300 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
            >
              <h3 class="mb-3 text-2xl font-light text-gray-900">
                {context.title}
              </h3>
              <p class="mb-6 flex-1 leading-relaxed text-gray-600">
                {context.description}
              </p>
              <p class="text-sm font-medium text-indigo-700">
                {context.resourceCount > 0
                  ? `${context.resourceCount} reviewed resources →`
                  : 'Reviewed collections in preparation →'}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
