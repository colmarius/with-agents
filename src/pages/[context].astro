---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { titleCase } from '@utils';
import type { GetStaticPaths } from 'astro';
import {
  resolveSummaryEntries,
  resolveSummarySlug,
  toManifestEntry,
} from '../components/resources/summaryResolver';
import {
  getCatalogResources,
  getResourceCatalog,
} from '../data/resources/catalogs';
import { type SiteContext, siteContexts } from '../data/site-contexts';

export const getStaticPaths = (() =>
  siteContexts.map((context) => ({
    params: { context: context.slug },
    props: { context },
  }))) satisfies GetStaticPaths;

type Props = {
  context: SiteContext;
};

const { context } = Astro.props;
const catalog = getResourceCatalog(context.catalogSlug);

if (!catalog) {
  throw new Error(
    `Site context ${context.slug} references unknown catalog ${context.catalogSlug}`,
  );
}

const catalogPath = `/resources/${catalog.slug}`;
const catalogResources = getCatalogResources(catalog);
const summaryEntriesByResourceId = new Map<
  number,
  ReturnType<typeof toManifestEntry>[]
>();

for (const entry of (await getCollection('summaries')).map(toManifestEntry)) {
  const entries = summaryEntriesByResourceId.get(entry.resourceId);
  if (entries) {
    entries.push(entry);
  } else {
    summaryEntriesByResourceId.set(entry.resourceId, [entry]);
  }
}

const reviewedResources = catalogResources.flatMap((resource) => {
  const summaryRef = resolveSummaryEntries(
    summaryEntriesByResourceId.get(resource.id) ?? [],
  );
  const summarySlug = summaryRef ? resolveSummarySlug(summaryRef) : null;

  return summarySlug ? [{ resource, summarySlug }] : [];
});
const reviewedResourceById = new Map(
  reviewedResources.map((entry) => [entry.resource.id, entry]),
);
const featuredResources = context.featuredResourceIds.map((resourceId) => {
  const entry = reviewedResourceById.get(resourceId);
  if (!entry) {
    throw new Error(
      `Site context ${context.slug} features unavailable resource ID ${resourceId}`,
    );
  }
  return entry;
});

const publicPosts = (await getCollection('posts')).filter(
  (post) => !post.data.draft && !post.data.unlisted,
);
const publicPostById = new Map(publicPosts.map((post) => [post.id, post]));
const featuredPosts = (context.featuredPostIds ?? []).map((postId) => {
  const post = publicPostById.get(postId);
  if (!post) {
    throw new Error(
      `Site context ${context.slug} features unavailable post ${postId}`,
    );
  }
  return post;
});
---

<Layout
  title={`${context.title} – With Agents`}
  description={context.description}
  canonicalPath={`/${context.slug}`}
>
  <div class="mx-auto max-w-5xl space-y-16 md:space-y-24">
    <header class="max-w-4xl space-y-7">
      <p class="text-sm font-medium uppercase tracking-[0.25em] text-indigo-600">
        {context.title}
      </p>
      <div class="space-y-6">
        <h1 class="max-w-4xl text-5xl font-light leading-[1.08] text-gray-950 md:text-6xl">
          {context.promise}
        </h1>
        <p class="max-w-3xl text-xl font-light leading-relaxed text-gray-600 md:text-2xl">
          {context.description}
        </p>
      </div>
      <div class="space-y-4">
        <p class="text-sm text-gray-500" aria-label={`${context.title} inventory`}>
          {featuredPosts.length > 0 && `${publicPosts.length} field guides · `}
          {reviewedResources.length} reviewed resources
        </p>
        <nav
          aria-label={`${context.title} library links`}
          class="flex flex-col gap-4 sm:flex-row"
        >
          <a
            href={catalogPath}
            class="inline-flex items-center justify-center rounded-lg bg-gray-900 px-5 py-3 font-medium text-white transition-colors duration-200 hover:bg-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
          >
            Search {reviewedResources.length} reviewed resources
          </a>
          {featuredPosts.length > 0 && (
            <a
              href="/posts"
              class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-5 py-3 font-medium text-gray-800 transition-colors duration-200 hover:border-gray-400 hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
            >
              Browse {publicPosts.length} field guides
            </a>
          )}
        </nav>
      </div>
    </header>

    {featuredPosts.length > 0 && (
      <section aria-labelledby="field-guides-heading" class="space-y-7">
        <div class="max-w-3xl space-y-3">
          <p class="text-sm font-medium uppercase tracking-[0.2em] text-indigo-600">
            Field guides
          </p>
          <h2 id="field-guides-heading" class="text-3xl font-light text-gray-900 md:text-4xl">
            Start with the core workflow.
          </h2>
        </div>

        <ul class="grid gap-5 lg:grid-cols-3">
          {featuredPosts.map((post) => (
            <li>
              <a
                href={`/posts/${post.id}`}
                class="group flex flex-col rounded-xl border border-gray-200 bg-white p-5 transition-all duration-200 hover:border-indigo-200 hover:bg-indigo-50/30 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2 sm:h-full"
              >
                <h3 class="mb-3 text-xl font-medium leading-snug text-gray-950 transition-colors group-hover:text-indigo-700">
                  {post.data.title}
                </h3>
                <p class="mb-5 line-clamp-3 flex-1 leading-relaxed text-gray-600 lg:line-clamp-none">
                  {post.data.description}
                </p>
                <span class="font-medium text-indigo-700">Read guide →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section
      aria-labelledby="reviewed-resources-heading"
      class="space-y-7"
    >
      <div class="max-w-3xl space-y-3">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-indigo-600">
          Reviewed sources
        </p>
        <h2 id="reviewed-resources-heading" class="text-3xl font-light text-gray-900 md:text-4xl">
          Open a source with the review attached.
        </h2>
      </div>

      <ul
        class:list={[
          'grid gap-5',
          featuredResources.length === 2
            ? 'md:grid-cols-2'
            : 'lg:grid-cols-3',
        ]}
      >
        {featuredResources.map(({ resource, summarySlug }) => (
          <li>
            <a
              href={`${catalogPath}?summary=${encodeURIComponent(summarySlug)}`}
              aria-haspopup="dialog"
              class="group flex flex-col rounded-xl border border-gray-200 bg-white p-5 transition-all duration-200 hover:border-indigo-200 hover:bg-indigo-50/30 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2 sm:h-full"
            >
              <p class="mb-3 text-sm text-gray-500">
                {resource.source} · {titleCase(resource.type)}
              </p>
              <h3 class="mb-3 text-xl font-medium leading-snug text-gray-950 transition-colors group-hover:text-indigo-700">
                {resource.title}
              </h3>
              <p class="mb-5 line-clamp-3 flex-1 leading-relaxed text-gray-600 lg:line-clamp-none">
                {resource.subtitle ?? resource.description}
              </p>
              <span class="font-medium text-indigo-700">Open summary →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
