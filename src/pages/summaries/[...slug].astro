---
import { type CollectionEntry, getCollection } from 'astro:content';
import BackNav from '@components/BackNav.astro';
import MarkdownRenderer from '@components/resources/MarkdownRenderer';
import {
  encodeSummarySlug,
  getSummaryPath,
  resolveSummaryEntries,
  resolveSummarySlug,
  type SummaryRef,
  toManifestEntry,
} from '@components/resources/summaryResolver';
import ScrollBackNav from '@components/ScrollBackNav.astro';
import Layout from '@layouts/Layout.astro';
import { formatDate } from '@utils';
import { resourceCatalogs, resources } from '../../data/resources/catalogs';
import type { Resource } from '../../types/resources';

type Props = {
  resource: Resource;
  summary: CollectionEntry<'summaries'>;
  summaryRef: SummaryRef;
};

export async function getStaticPaths() {
  const summaries = await getCollection('summaries');
  const manifest = summaries.map(toManifestEntry);
  const resourcesById = new Map(
    resources.map((resource) => [resource.id, resource]),
  );
  const entriesByResourceId = new Map<number, typeof manifest>();

  for (const entry of manifest) {
    const entries = entriesByResourceId.get(entry.resourceId);
    if (entries) {
      entries.push(entry);
    } else {
      entriesByResourceId.set(entry.resourceId, [entry]);
    }
  }

  return summaries.map((summary) => {
    const resource = resourcesById.get(summary.data.resourceId);
    if (!resource) {
      throw new Error(
        `Summary ${summary.id} references unknown resource ${summary.data.resourceId}`,
      );
    }

    const summaryRef = resolveSummaryEntries(
      entriesByResourceId.get(resource.id) ?? [],
    );
    const summarySlug = encodeSummarySlug(summary.id);

    if (
      !summaryRef ||
      summaryRef.kind === 'error' ||
      resolveSummarySlug(summaryRef, summarySlug) === null
    ) {
      const reason =
        summaryRef?.kind === 'error'
          ? summaryRef.message
          : 'summary is not owned by its resource';
      throw new Error(
        `Cannot create summary page for ${summary.id}: ${reason}`,
      );
    }

    if (
      !resourceCatalogs.some((catalog) =>
        catalog.resourceIds.includes(resource.id),
      )
    ) {
      throw new Error(
        `Summary ${summary.id} belongs to resource ${resource.id}, which is not in a catalog`,
      );
    }

    return {
      params: { slug: summary.id },
      props: { resource, summary, summaryRef },
    };
  });
}

const { resource, summary, summaryRef } = Astro.props;
const summarySlug = encodeSummarySlug(summary.id);
const canonicalPath = getSummaryPath(summarySlug);
const summaryDate = summary.data.date ?? new Date(resource.date);
const groupedEntries =
  summaryRef.kind === 'series' || summaryRef.kind === 'collection'
    ? summaryRef.entries
    : [];
const selectedIndex = groupedEntries.findIndex(
  (entry) => entry.slug === summarySlug,
);
const previousEntry =
  selectedIndex > 0 ? groupedEntries[selectedIndex - 1] : null;
const nextEntry =
  selectedIndex >= 0 && selectedIndex < groupedEntries.length - 1
    ? groupedEntries[selectedIndex + 1]
    : null;
const isGrouped = groupedEntries.length > 0;
const navigationLabel =
  summaryRef.kind === 'series' ? 'Episodes' : 'In this collection';
const showResourceTitle = resource.title !== summary.data.title;
const originalLinkLabel =
  resource.type === 'video'
    ? 'Watch original video'
    : resource.type === 'playlist'
      ? 'Open original playlist'
      : resource.type === 'podcast'
        ? 'Listen to original podcast'
        : 'Read original article';
const trimEpisodeSuffix = (title: string) =>
  title.replace(/\s*-\s*Episode\s+\d+$/i, '');
const catalogMemberships = resourceCatalogs.flatMap((catalog) => {
  if (!catalog.resourceIds.includes(resource.id)) return [];

  const sectionKey = catalog.sectionByResourceId[resource.id];
  const section = catalog.sections.find((entry) => entry.key === sectionKey);
  if (!section) {
    throw new Error(
      `Resource ${resource.id} has no valid section in catalog ${catalog.slug}`,
    );
  }

  return [
    {
      catalogTitle: catalog.title,
      sectionTitle: section.label,
      href: `/resources/${catalog.slug}/${section.routeSlug}#resource-${resource.id}`,
    },
  ];
});
const primaryMembership = catalogMemberships[0];
const otherCatalogMemberships = catalogMemberships.slice(1);

if (!primaryMembership) {
  throw new Error(`Resource ${resource.id} has no catalog membership`);
}
---

<Layout
  title={`${summary.data.title} – Summary – With Agents`}
  description={resource.description}
  canonicalPath={canonicalPath}
  ogType="article"
>
  <div
    class:list={[
      'mx-auto pb-16',
      isGrouped ? 'max-w-5xl' : 'max-w-2xl',
    ]}
  >
    <div
      class:list={[
        isGrouped &&
          'lg:grid lg:grid-cols-[16rem_minmax(0,42rem)] lg:items-start lg:justify-center lg:gap-12',
      ]}
    >
      {
        isGrouped && (
          <aside class="hidden lg:block lg:self-stretch">
            <nav
              aria-label="Summary navigation"
              class="summary-navigation-rail sticky top-6 flex max-h-[calc(100dvh-12rem)] flex-col"
            >
              <BackNav
                href={primaryMembership.href}
                label={`Back to ${primaryMembership.catalogTitle} resources`}
                class="shrink-0"
              />
              <div class="mt-6 flex min-h-0 flex-1 flex-col border-t border-slate-200 pt-5">
                <div class="flex shrink-0 items-baseline justify-between gap-3">
                  <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    {navigationLabel}
                  </h2>
                  <span class="text-xs tabular-nums text-gray-500">
                    {selectedIndex + 1} of {groupedEntries.length}
                  </span>
                </div>
                <div
                  class="summary-index-scroll mt-3 min-h-0 flex-1 overflow-y-auto pr-2"
                  data-summary-index-scroll
                >
                  <ol class="border-l border-slate-200 pb-px">
                    {groupedEntries.map((entry) => {
                      const isCurrent = entry.slug === summarySlug;
                      return (
                        <li>
                          <a
                            href={getSummaryPath(entry.slug)}
                            aria-current={isCurrent ? 'page' : undefined}
                            class:list={[
                              '-ml-px block border-l-2 py-1.5 pl-3 pr-2 text-sm leading-snug transition-colors focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600/50',
                              isCurrent
                                ? 'border-indigo-600 font-medium text-slate-950'
                                : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-900',
                            ]}
                          >
                            {summaryRef.kind === 'series' && (
                              <span class="mb-0.5 block text-xs font-medium text-gray-500">
                                Episode {entry.episode}
                              </span>
                            )}
                            {trimEpisodeSuffix(entry.title)}
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              </div>
            </nav>
          </aside>
        )
      }

      <article class="min-w-0">
        {
          isGrouped ? (
            <div class="lg:hidden">
              <ScrollBackNav
                href={primaryMembership.href}
                label={`Back to ${primaryMembership.catalogTitle} resources`}
                class="mb-8"
              />
            </div>
          ) : (
            <ScrollBackNav
              href={primaryMembership.href}
              label={`Back to ${primaryMembership.catalogTitle} resources`}
              class="mb-8"
            />
          )
        }

        <header class="mb-8 border-b border-slate-200 pb-7 sm:mb-10">
          {
            showResourceTitle && (
              <p class="mb-3 text-sm font-medium text-indigo-700">
                {resource.title}
              </p>
            )
          }
          <h1 class="text-3xl font-semibold leading-tight text-slate-900 sm:text-4xl">
            {summary.data.title}
          </h1>
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-600">
            <span class="font-medium text-slate-700">{resource.source}</span>
            <span aria-hidden="true">·</span>
            <time datetime={summaryDate.toISOString()}>{formatDate(summaryDate)}</time>
            {
              summaryRef.kind === 'series' && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>Episode {summary.data.episode}</span>
                </>
              )
            }
            {
              isGrouped && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    {selectedIndex + 1} of {groupedEntries.length}
                  </span>
                </>
              )
            }
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-medium text-indigo-700 underline decoration-indigo-300 underline-offset-4 transition-colors hover:text-indigo-500 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
            >
              {originalLinkLabel}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
            {
              otherCatalogMemberships.length > 0 && (
                <nav aria-label="Other resource catalogs" class="text-sm text-gray-500">
                  <span>Also in </span>
                  {otherCatalogMemberships.map((membership, index) => (
                    <>
                      {index > 0 && <span aria-hidden="true"> · </span>}
                      <a
                        href={membership.href}
                        class="text-indigo-700 underline decoration-indigo-300 underline-offset-2 hover:text-indigo-500 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
                      >
                        {membership.catalogTitle}
                      </a>
                    </>
                  ))}
                </nav>
              )
            }
          </div>
        </header>

        {
          isGrouped && (
            <details class="group mb-8 border-y border-slate-200 lg:hidden">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600/50 [&::-webkit-details-marker]:hidden">
                <span class="min-w-0">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">
                    {navigationLabel}
                  </span>
                  <span class="mt-0.5 block text-sm font-medium leading-snug text-gray-900">
                    Browse {groupedEntries.length} summaries
                  </span>
                </span>
                <span class="flex shrink-0 items-center gap-2 text-xs tabular-nums text-gray-500">
                  <span>{selectedIndex + 1} of {groupedEntries.length}</span>
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="none"
                    class="h-4 w-4 transition-transform group-open:rotate-180"
                  >
                    <path
                      d="m5 7.5 5 5 5-5"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.75"
                    />
                  </svg>
                </span>
              </summary>
              <nav
                class="border-t border-slate-200 py-2"
                aria-label={navigationLabel}
              >
                <ol class="border-l border-slate-200">
                  {groupedEntries.map((entry) => {
                    const isCurrent = entry.slug === summarySlug;
                    return (
                      <li>
                        <a
                          href={getSummaryPath(entry.slug)}
                          aria-current={isCurrent ? 'page' : undefined}
                          class:list={[
                            '-ml-px block border-l-2 py-2 pl-3 pr-2 text-sm leading-snug focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-600/50',
                            isCurrent
                              ? 'border-indigo-600 font-medium text-slate-950'
                              : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-900',
                          ]}
                        >
                          {summaryRef.kind === 'series' && (
                            <span class="mr-2 text-xs font-medium text-gray-500">
                              Ep {entry.episode}
                            </span>
                          )}
                          {trimEpisodeSuffix(entry.title)}
                        </a>
                      </li>
                    );
                  })}
                </ol>
              </nav>
            </details>
          )
        }

        <MarkdownRenderer markdown={summary.body ?? ''} />

        {
          isGrouped && (previousEntry || nextEntry) && (
            <nav
              class="mt-14 grid grid-cols-1 gap-x-8 gap-y-3 border-t border-slate-200 pt-6 sm:grid-cols-2"
              aria-label={`${navigationLabel} pagination`}
            >
              {previousEntry ? (
                <a
                  href={getSummaryPath(previousEntry.slug)}
                  class="group py-2 text-left focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50"
                >
                  <span class="block text-xs font-medium uppercase tracking-wide text-slate-500">
                    ←{' '}
                    {summaryRef.kind === 'series'
                      ? 'Newer episode'
                      : 'Previous summary'}
                  </span>
                  <span class="mt-1 block text-sm font-medium text-slate-800 transition-colors group-hover:text-indigo-700">
                    {trimEpisodeSuffix(previousEntry.title)}
                  </span>
                </a>
              ) : (
                <span class="hidden sm:block" />
              )}
              {nextEntry && (
                <a
                  href={getSummaryPath(nextEntry.slug)}
                  class="group py-2 text-left focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 sm:text-right"
                >
                  <span class="block text-xs font-medium uppercase tracking-wide text-slate-500">
                    {summaryRef.kind === 'series'
                      ? 'Older episode'
                      : 'Next summary'}{' '}
                    →
                  </span>
                  <span class="mt-1 block text-sm font-medium text-slate-800 transition-colors group-hover:text-indigo-700">
                    {trimEpisodeSuffix(nextEntry.title)}
                  </span>
                </a>
              )}
            </nav>
          )
        }

        <footer class="mt-14 border-t border-slate-200 pt-6">
          <p class="text-sm leading-relaxed text-slate-500">
            <span>Find this resource in </span>
            {
              catalogMemberships.map((membership, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">; </span>}
                  <a
                    href={membership.href}
                    class="font-medium text-indigo-700 underline decoration-indigo-300 underline-offset-2 transition-colors hover:text-indigo-500 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
                  >
                    {membership.catalogTitle} · {membership.sectionTitle}
                  </a>
                </>
              ))
            }
            <span>.</span>
          </p>
        </footer>
      </article>
    </div>
  </div>
</Layout>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-summary-index-scroll]')
    .forEach((index) => {
      const current = index.querySelector<HTMLElement>('[aria-current="page"]');
      if (!current) return;

      const revealCurrent = () => {
        window.requestAnimationFrame(() => {
          if (index.clientHeight === 0 || index.scrollHeight <= index.clientHeight) {
            return;
          }

          const indexBounds = index.getBoundingClientRect();
          const currentBounds = current.getBoundingClientRect();
          if (
            currentBounds.top >= indexBounds.top &&
            currentBounds.bottom <= indexBounds.bottom
          ) {
            return;
          }

          index.scrollTop +=
            currentBounds.top -
            indexBounds.top -
            (index.clientHeight - currentBounds.height) / 2;
        });
      };

      revealCurrent();
      window.addEventListener('resize', revealCurrent);
    });
</script>

<style>
  .summary-index-scroll {
    scrollbar-width: thin;
  }

  @media (min-width: 64rem) and (max-height: 35.999rem) {
    .summary-navigation-rail {
      position: static;
      max-height: none;
    }

    .summary-index-scroll {
      overflow: visible;
    }
  }

  :global(html) {
    scroll-padding-top: 4rem;
  }
</style>
