---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import { createPostStaticPaths, getPostPath, getPostSlidesPath } from '@utils';

export async function getStaticPaths() {
  return createPostStaticPaths(
    await getCollection('posts'),
    import.meta.env.PROD,
  );
}

type Props = CollectionEntry<'posts'>;

const post = Astro.props;
const { Content } = await render(post);

if (Astro.params.context !== post.data.context) {
  throw new Error(`Post ${post.id} rendered under the wrong site context`);
}
---

<PostLayout
	context={post.data.context}
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	tags={post.data.tags}
	canonicalPath={post.data.canonicalPath}
	noindex={post.data.noindex}
	routePath={getPostPath(post)}
	slidesPath={getPostSlidesPath(post)}
>
	<Content />
</PostLayout>
