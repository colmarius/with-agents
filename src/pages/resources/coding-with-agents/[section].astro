---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import CodingWithAgentsList from '../../../components/resources/CodingWithAgents';
import ResourcesNav from '../../../components/resources/ResourcesNav.astro';
import { toManifestEntry } from '../../../components/resources/summaryResolver';
import { codingResources } from '../../../data/resources/coding-with-agents';
import {
  type ResourceSection,
  resourceSections,
} from '../../../data/resources/sections';
import Layout from '../../../layouts/Layout.astro';

export const getStaticPaths = (() =>
  resourceSections.map((section) => ({
    params: { section: section.routeSlug },
    props: { section },
  }))) satisfies GetStaticPaths;

type Props = {
  section: ResourceSection;
};

const { section } = Astro.props;
const resources = codingResources.filter(
  (resource) => resource.primarySection === section.key,
);
const entries = await getCollection('summaries');
const manifest = entries.map(toManifestEntry);
const canonicalPath = `/resources/coding-with-agents/${section.routeSlug}`;
---

<Layout
  title={`With Agents – ${section.label}`}
  description={section.description}
  canonicalPath={canonicalPath}
>
  <div class="max-w-4xl mx-auto">
    <ResourcesNav active={section.key} />

    <h1 class="text-3xl md:text-4xl font-light mb-4 text-gray-900">
      {section.label}
    </h1>
    <p class="text-lg text-gray-600 mb-12 font-light leading-relaxed">
      {section.description}
    </p>

    <CodingWithAgentsList
      client:load
      manifest={manifest}
      resources={resources}
    />
  </div>
</Layout>
