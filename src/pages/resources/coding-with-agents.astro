---
import { getCollection } from 'astro:content';
import CodingWithAgentsList from '../../components/resources/CodingWithAgents';
import ResourcesNav from '../../components/resources/ResourcesNav.astro';
import { toManifestEntry } from '../../components/resources/summaryResolver';
import { codingResources } from '../../data/resources/coding-with-agents';
import Layout from '../../layouts/Layout.astro';

const entries = await getCollection('summaries');
const manifest = entries.map(toManifestEntry);
---

<Layout
  title="With Agents – Coding with Agents Resources"
  description="Podcasts, videos, playlists, transcript-backed summaries, and practical references for coding-agent workflows."
  canonicalPath="/resources/coding-with-agents"
>
  <div class="max-w-4xl mx-auto">
    <ResourcesNav active="all" />

    <h1 class="text-3xl md:text-4xl font-light mb-4 text-gray-900">
      Coding with Agents
    </h1>
    <p class="text-lg text-gray-600 mb-12 font-light leading-relaxed">
      Podcasts, videos, and playlists exploring AI-powered coding workflows,
      agentic design patterns, and the future of software development.
    </p>

    <CodingWithAgentsList
      client:load
      manifest={manifest}
      resources={codingResources}
    />
  </div>
</Layout>
