---
import type { GetStaticPaths } from 'astro';
import ResourceCatalogPage from '../../../components/resources/ResourceCatalogPage.astro';
import { resourceCatalogs } from '../../../data/resources/catalogs';
import type {
  ResourceCatalog,
  ResourceSection,
} from '../../../types/resources';

export const getStaticPaths = (() =>
  resourceCatalogs.flatMap((catalog) =>
    catalog.sections.map((section) => ({
      params: { topic: catalog.slug, section: section.routeSlug },
      props: { catalog, section },
    })),
  )) satisfies GetStaticPaths;

type Props = {
  catalog: ResourceCatalog;
  section: ResourceSection;
};

const { catalog, section } = Astro.props;
---

<ResourceCatalogPage catalog={catalog} section={section} />
