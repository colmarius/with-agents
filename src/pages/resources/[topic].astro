---
import type { GetStaticPaths } from 'astro';
import ResourceCatalogPage from '../../components/resources/ResourceCatalogPage.astro';
import { resourceCatalogs } from '../../data/resources/catalogs';
import type { ResourceCatalog } from '../../types/resources';

export const getStaticPaths = (() =>
  resourceCatalogs.map((catalog) => ({
    params: { topic: catalog.slug },
    props: { catalog },
  }))) satisfies GetStaticPaths;

type Props = {
  catalog: ResourceCatalog;
};

const { catalog } = Astro.props;
---

<ResourceCatalogPage catalog={catalog} />
