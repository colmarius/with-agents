---
import BackNav from '@components/BackNav.astro';
import DotAgentsHighlight from '../../components/DotAgentsHighlight.astro';
import {
  getCatalogResources,
  resourceCatalogs,
} from '../../data/resources/catalogs';
import Layout from '../../layouts/Layout.astro';

const catalogs = resourceCatalogs.map((catalog) => ({
  ...catalog,
  resourceCount: getCatalogResources(catalog).length,
}));
const codingCatalog = resourceCatalogs.find(
  (catalog) => catalog.slug === 'coding-with-agents',
);
const codingSections = (codingCatalog?.sections ?? []).map((section) => ({
  ...section,
  resourceCount: codingCatalog
    ? getCatalogResources(codingCatalog, section.key).length
    : 0,
}));
---

<Layout
  title="With Agents – Resources"
  description="Curated, transcript-backed resources for coding agents, cloud engineering, and security."
  canonicalPath="/resources"
>
  <div class="max-w-4xl mx-auto">
    <nav class="mb-10" aria-label="Parent page">
      <BackNav href="/" label="Back to Home" />
    </nav>
    <h1 class="text-4xl md:text-5xl font-light mb-4 text-gray-900">
      Resources
    </h1>
    <p class="text-xl text-gray-600 mb-12 font-light leading-relaxed">
      Browse practical, source-backed collections for coding agents, cloud
      engineering, and security.
    </p>

    <section aria-labelledby="topics-heading">
      <h2 id="topics-heading" class="sr-only">Resource topics</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {
          catalogs.map((catalog) => (
            <a
              href={`/resources/${catalog.slug}`}
              class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 transition-all duration-200 hover:border-gray-300 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
            >
              <h2 class="mb-3 text-2xl font-light text-gray-900">
                {catalog.title}
              </h2>
              <p class="mb-6 flex-1 leading-relaxed text-gray-600">
                {catalog.indexDescription}
              </p>
              <p class="text-sm font-medium text-indigo-700">
                {catalog.resourceCount > 0
                  ? `${catalog.resourceCount} resources →`
                  : 'Collections in preparation →'}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="collections-heading">
      <h2
        id="collections-heading"
        class="mb-6 text-2xl font-light text-gray-900"
      >
        Coding with Agents collections
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          codingSections.map((section) => (
            <a
              href={`/resources/coding-with-agents/${section.routeSlug}`}
              class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 transition-all duration-200 hover:border-gray-300 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
            >
              <h3 class="mb-3 text-2xl font-light text-gray-900">
                {section.label}
              </h3>
              <p class="mb-6 flex-1 leading-relaxed text-gray-600">
                {section.description}
              </p>
              <p class="text-sm font-medium text-indigo-700">
                {section.resourceCount} resources →
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <div class="mt-12">
      <DotAgentsHighlight compact />
    </div>
  </div>
</Layout>
