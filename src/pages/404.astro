---
import Layout from '@layouts/Layout.astro';
---

<Layout
  title="Page not found – With Agents"
  description="The page you were looking for could not be found. Return to the With Agents home page to keep exploring."
  canonicalPath="/404"
  noindex
>
  <section class="mx-auto max-w-3xl py-10 md:py-20">
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.25em] text-indigo-600">
      Error 404
    </p>
    <h1 class="mb-6 text-5xl font-light leading-tight text-gray-950 md:text-6xl">
      Page not found.
    </h1>
    <p class="mb-8 max-w-2xl text-xl font-light leading-relaxed text-gray-600">
      This link may be outdated, or the page may have moved. Return home to choose a context and continue exploring.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center rounded-lg bg-gray-900 px-5 py-3 font-medium text-white transition-colors duration-200 hover:bg-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
    >
      Go to Home
    </a>
  </section>
</Layout>
