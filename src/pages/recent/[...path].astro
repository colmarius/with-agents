---
import type { GetStaticPaths } from 'astro';
import RecentTimeline from '../../components/recent/RecentTimeline.astro';
import { getRecentAdditions } from '../../data/recent-additions';
import Layout from '../../layouts/Layout.astro';
import {
  getRecentPath,
  paginateRecentAdditions,
  type RecentTopic,
} from '../../utils/recent-additions';

export const getStaticPaths = (async () => {
  const { items, topics } = await getRecentAdditions();
  return [{ slug: 'all', label: 'All topics' }, ...topics].flatMap((topic) => {
    const firstPage = paginateRecentAdditions(items, topic.slug);
    return Array.from({ length: firstPage.totalPages }, (_, index) => {
      const page = index + 1;
      const path =
        getRecentPath(topic.slug, page)
          .slice('/recent/'.length)
          .replace(/\/$/, '') || undefined;
      return {
        params: { path },
        props: {
          topic,
          topics,
          result: paginateRecentAdditions(items, topic.slug, page),
        },
      };
    });
  });
}) satisfies GetStaticPaths;

type Props = {
  topic: RecentTopic;
  topics: RecentTopic[];
  result: ReturnType<typeof paginateRecentAdditions>;
};
const { topic, topics, result } = Astro.props;
const first = topic.slug === 'all' && result.page === 1;
const title = `Recently added${topic.slug === 'all' ? '' : ` · ${topic.label}`}${result.page === 1 ? '' : ` · Page ${result.page}`}`;
---

<Layout title={`${title} | With Agents`} description="New to this library, not necessarily new to the world. Explore recently added posts, resources, and collection summaries across all topics." canonicalPath={getRecentPath(topic.slug, result.page)} noindex={!first}>
  <div class="mx-auto max-w-5xl">
    <div class="mb-9 max-w-3xl" data-search-body data-search-title="Recently added">
      <h1 class="text-4xl font-light tracking-tight text-gray-950 sm:text-5xl">Recently added</h1>
      <p class="mt-4 text-lg font-light leading-relaxed text-gray-600">New to this library, not necessarily new to the world.</p>
    </div>
    <nav aria-label="Topics" class="mb-6">
      <p class="mb-2 text-xs font-medium uppercase tracking-wider text-gray-500">Topics</p>
      <ul class="inline-flex max-w-full flex-wrap gap-1 rounded-lg bg-gray-100 p-1">
        {[{ slug: 'all', label: 'All topics' }, ...topics].map((option) => <li>
          <a href={getRecentPath(option.slug)} aria-current={option.slug === topic.slug ? 'page' : undefined} class:list={['block rounded-md px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-indigo-600', option.slug === topic.slug ? 'bg-white font-medium text-indigo-700 shadow-sm' : 'text-gray-600 hover:text-gray-900']}>{option.label}</a>
        </li>)}
      </ul>
    </nav>
    {result.total === 0 ? (
      <div class="rounded-lg bg-gray-50 p-8 text-center">
        <h2 class="text-xl font-medium text-gray-900">No additions yet</h2>
        <a href="/resources" class="mt-4 inline-block text-indigo-700 hover:underline">Browse the resource library →</a>
      </div>
    ) : <RecentTimeline items={result.items} topics={topics} />}
    {result.totalPages > 1 && <nav aria-label="Recent additions pages" class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 pt-6 text-sm">
      {result.page > 1 ? <a rel="prev" class="text-indigo-700 hover:underline" href={getRecentPath(topic.slug, result.page - 1)}>← Newer additions</a> : <span />}
      <span class="text-gray-500">Page {result.page} of {result.totalPages}</span>
      {result.page < result.totalPages ? <a rel="next" class="text-indigo-700 hover:underline" href={getRecentPath(topic.slug, result.page + 1)}>Older additions →</a> : <span />}
    </nav>}
  </div>
</Layout>
