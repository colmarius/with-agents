---
import { getCollection } from 'astro:content';
import {
  getCatalogResources,
  resourceCatalogs,
} from '../../data/resources/catalogs';
import Layout from '../../layouts/Layout.astro';
import { getSearchableResourceIds } from '../../search/build';
import type { ResourceCatalog, ResourceSection } from '../../types/resources';
import FeaturedPeople from './FeaturedPeople.astro';
import ResourceCatalogList from './ResourceCatalog';
import ResourcesNav from './ResourcesNav.astro';
import {
  getSummaryPath,
  resolveSummaryEntries,
  toManifestEntry,
} from './summaryResolver';

type Props = {
  catalog: ResourceCatalog;
  section?: ResourceSection;
};

const { catalog, section } = Astro.props;
const resources = getCatalogResources(catalog, section?.key);
const manifest = (await getCollection('summaries')).map(toManifestEntry);
const searchableResourceIds = getSearchableResourceIds(
  catalog,
  section?.key,
  resourceCatalogs,
  manifest,
);
const heading = section?.label ?? catalog.title;
const description = section?.description ?? catalog.description;
const canonicalPath = section
  ? `/resources/${catalog.slug}/${section.routeSlug}`
  : `/resources/${catalog.slug}`;
const pageTitle = section
  ? `With Agents – ${section.label}`
  : `With Agents – ${catalog.title} Resources`;
const showFeaturedPeople =
  catalog.slug === 'coding-with-agents' && section === undefined;
const selection = section?.featuredSelection;
const selectedSummaries = selection?.resourceIds.map((resourceId) => {
  const entries = manifest.filter((entry) => entry.resourceId === resourceId);
  const ref = resolveSummaryEntries(entries);
  if (ref?.kind !== 'single') {
    throw new Error(
      `Featured selection ${selection.anchor} requires a standalone summary for resource ${resourceId}`,
    );
  }
  return { title: entries[0].title, href: getSummaryPath(ref.slug) };
});
---

<Layout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
>
  <div class="max-w-4xl mx-auto" data-search-title={heading} data-search-parent={section ? catalog.title : ''}>
    <ResourcesNav active={section?.key ?? 'all'} catalog={catalog} />

    <h1 class="text-3xl md:text-4xl font-light mb-4 text-gray-900" data-search-body>
      {heading}
    </h1>
    <p
      data-search-body
      class:list={[
        'text-lg text-gray-600 font-light leading-relaxed',
        showFeaturedPeople ? 'mb-6' : 'mb-12',
      ]}
    >
      {description}
    </p>

    {selection && (
      <aside id={selection.anchor} aria-labelledby={`${selection.anchor}-title`} data-search-ignore class="mb-10 -mt-6 scroll-mt-24 rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500">Editorial selection</p>
        <h2 id={`${selection.anchor}-title`} class="text-lg font-medium text-gray-900">{selection.label}</h2>
        <p class="mt-2 text-sm leading-relaxed text-gray-600">{selection.description}</p>
        <nav aria-label={`${selection.label} summaries`} class="mt-4">
          <ul class="grid gap-3 sm:grid-cols-2">
            {selectedSummaries?.map((summary) => (
              <li>
                <a href={summary.href} class="block text-sm font-medium text-indigo-700 underline decoration-indigo-200 underline-offset-4 hover:text-indigo-500 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2">{summary.title}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Further discovery — official sources" class="mt-5 border-t border-gray-100 pt-4 text-sm">
        <p class="mb-2 font-medium text-gray-700">Further discovery — official sources</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-3">
          {selection.discoveryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-indigo-700 underline underline-offset-4 hover:text-indigo-500 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      </aside>
    )}

    {showFeaturedPeople && <FeaturedPeople manifest={manifest} />}

    <ResourceCatalogList
      client:load
      emptyMessage={`Reviewed resources are being prepared for this ${section ? 'collection' : 'topic'}.`}
      manifest={manifest}
      resources={resources}
      searchableResourceIds={searchableResourceIds}
      topicOptions={catalog.topicOptions}
    />
  </div>
</Layout>
