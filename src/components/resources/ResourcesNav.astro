---
import BackNav from '@components/BackNav.astro';
import {
  type ResourceSectionKey,
  resourceSections,
} from '../../data/resources/sections';

type ActiveSection = 'all' | ResourceSectionKey;

type Props = {
  active: ActiveSection;
};

const { active } = Astro.props;

const linkClass = (isActive: boolean) =>
  `px-4 py-2 rounded-full text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2 ${
    isActive
      ? 'bg-gray-900 text-white shadow-sm'
      : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 hover:border-gray-400'
  }`;
---

<nav class="mb-10" aria-label="Coding with Agents collections">
  <BackNav href="/resources" label="Back to Resources" class="mb-6" />
  <div class="flex flex-wrap gap-2">
    <a
      href="/resources/coding-with-agents"
      class={linkClass(active === 'all')}
      aria-current={active === 'all' ? 'page' : undefined}
    >
      All
    </a>
    {
      resourceSections.map((section) => (
        <a
          href={`/resources/coding-with-agents/${section.routeSlug}`}
          class={linkClass(active === section.key)}
          aria-current={active === section.key ? 'page' : undefined}
        >
          {section.label}
        </a>
      ))
    }
  </div>
</nav>
