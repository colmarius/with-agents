---
import BackNav from '@components/BackNav.astro';
import { siteContexts } from '../../data/site-contexts';
import type { ResourceCatalog } from '../../types/resources';

type Props = {
  active: string;
  catalog: ResourceCatalog;
};

const { active, catalog } = Astro.props;
const context = siteContexts.find(
  (siteContext) => siteContext.catalogSlug === catalog.slug,
);

if (!context) {
  throw new Error(
    `Resource catalog ${catalog.slug} has no owning site context`,
  );
}

const parentLink =
  active === 'all'
    ? { href: `/${context.slug}`, label: `Back to ${context.title}` }
    : {
        href: `/resources/${catalog.slug}`,
        label: `Back to all ${catalog.title} resources`,
      };

const linkClass = (isActive: boolean) =>
  `px-4 py-2 rounded-full text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2 ${
    isActive
      ? 'bg-gray-900 text-white shadow-sm'
      : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 hover:border-gray-400'
  }`;
---

<nav class="mb-10" aria-label={`${catalog.title} collections`}>
  <BackNav href={parentLink.href} label={parentLink.label} class="mb-6" />
  <div class="flex flex-wrap gap-2">
    <a
      href={`/resources/${catalog.slug}`}
      class={linkClass(active === 'all')}
      aria-current={active === 'all' ? 'page' : undefined}
    >
      All
    </a>
    {
      catalog.sections.map((section) => (
        <a
          href={`/resources/${catalog.slug}/${section.routeSlug}`}
          class={linkClass(active === section.key)}
          aria-current={active === section.key ? 'page' : undefined}
        >
          {section.label}
        </a>
      ))
    }
  </div>
</nav>
