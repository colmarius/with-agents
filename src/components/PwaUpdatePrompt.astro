<div class="pwa-update-prompt" data-pwa-update-prompt hidden>
  <button class="pwa-update-action" data-pwa-update-action type="button">
    <span class="pwa-update-icon" aria-hidden="true">↻</span>
    <span data-pwa-update-label>Reload to update</span>
    <kbd class="pwa-update-shortcut" data-pwa-update-shortcut hidden aria-hidden="true">
      ⌘ R
    </kbd>
  </button>
</div>

<p class="pwa-update-status" data-pwa-update-status aria-live="polite"></p>

<script>
  import { Workbox } from 'workbox-window';

  const prompt = document.querySelector<HTMLElement>('[data-pwa-update-prompt]');
  const action = document.querySelector<HTMLButtonElement>('[data-pwa-update-action]');
  const label = document.querySelector<HTMLElement>('[data-pwa-update-label]');
  const shortcut = document.querySelector<HTMLElement>('[data-pwa-update-shortcut]');
  const status = document.querySelector<HTMLElement>('[data-pwa-update-status]');

  if (
    import.meta.env.PROD &&
    'serviceWorker' in navigator &&
    prompt &&
    action &&
    label &&
    shortcut &&
    status
  ) {
    const isMac = /Mac/.test(navigator.platform) && navigator.maxTouchPoints <= 1;
    const updateIntervalMs = 60 * 60 * 1000;
    const workbox = new Workbox('/sw.js', {
      scope: '/',
      updateViaCache: 'none',
    });

    let registration: ServiceWorkerRegistration | undefined;
    let hasController = navigator.serviceWorker.controller !== null;
    let updateAvailable = false;
    let accepting = false;
    let reloading = false;

    shortcut.hidden = !isMac;

    const showUpdate = () => {
      updateAvailable = true;
      prompt.hidden = false;
      status.textContent = 'A site update is available.';
    };

    const acceptUpdate = () => {
      if (!updateAvailable || accepting) return;

      accepting = true;
      action.disabled = true;
      label.textContent = 'Updating…';
      status.textContent = 'Updating the site.';
      workbox.messageSkipWaiting();
    };

    const checkForUpdate = async () => {
      if (
        !registration ||
        document.visibilityState !== 'visible' ||
        !navigator.onLine ||
        registration.installing ||
        registration.waiting
      ) {
        return;
      }

      try {
        await workbox.update();
      } catch (error) {
        console.error('Service worker update check failed.', error);
      }
    };

    workbox.addEventListener('waiting', showUpdate);
    workbox.addEventListener('controlling', () => {
      if (!hasController && !accepting) {
        hasController = true;
        return;
      }
      if (reloading) return;

      hasController = true;
      reloading = true;
      window.location.reload();
    });

    action.addEventListener('click', acceptUpdate);
    document.addEventListener(
      'keydown',
      (event) => {
        const isUpdateShortcut =
          isMac &&
          !prompt.hidden &&
          event.metaKey &&
          !event.ctrlKey &&
          !event.altKey &&
          !event.shiftKey &&
          event.key.toLowerCase() === 'r';

        if (!isUpdateShortcut) return;

        event.preventDefault();
        acceptUpdate();
      },
      { capture: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void checkForUpdate();
    });
    window.addEventListener('pageshow', () => void checkForUpdate());

    try {
      registration = await workbox.register();

      if (registration?.active && registration.waiting) showUpdate();
      if (registration) {
        window.setInterval(() => void checkForUpdate(), updateIntervalMs);
      }
    } catch (error) {
      console.error('Service worker registration failed.', error);
    }
  }
</script>

<style>
  .pwa-update-prompt {
    position: fixed;
    z-index: 60;
    bottom: max(1rem, calc(env(safe-area-inset-bottom) + 1rem));
    left: 50%;
    width: max-content;
    max-width: calc(100% - 2rem);
    transform: translateX(-50%);
  }

  .pwa-update-prompt[hidden],
  .pwa-update-shortcut[hidden] {
    display: none;
  }

  :global(body.pwa-slides) .pwa-update-prompt {
    bottom: max(1rem, calc(env(safe-area-inset-bottom) + 1rem));
    left: max(1rem, env(safe-area-inset-left));
    transform: none;
  }

  .pwa-update-action {
    display: flex;
    max-width: 100%;
    min-height: 3rem;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.96);
    padding: 0.625rem 0.75rem;
    color: #1e293b;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: left;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.14);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .pwa-update-action:hover {
    border-color: #cbd5e1;
    background: #fff;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.18);
  }

  .pwa-update-action:focus-visible {
    outline: 2px solid #4f46e5;
    outline-offset: 2px;
  }

  .pwa-update-action:disabled {
    cursor: wait;
    opacity: 0.75;
  }

  .pwa-update-icon {
    color: #4f46e5;
    font-size: 1.25rem;
    line-height: 1;
  }

  .pwa-update-shortcut {
    display: inline-flex;
    min-width: 3.25rem;
    min-height: 1.75rem;
    margin-left: auto;
    align-items: center;
    justify-content: center;
    border: 1px solid #dbe1e8;
    border-radius: 0.4rem;
    background: #f8fafc;
    color: #475569;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
  }

  .pwa-update-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media print {
    .pwa-update-prompt,
    .pwa-update-status {
      display: none !important;
    }
  }
</style>
