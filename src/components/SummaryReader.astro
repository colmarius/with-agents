<dialog data-summary-reader aria-label="Summary reading mode">
  <div data-reader-panel tabindex="-1">
    <div class="reader-toolbar" data-reader-toolbar>
      <span class="reader-label">Reading mode</span>
      <div class="reader-actions">
        <button type="button" data-reader-fullscreen hidden title="Hide browser controls">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path data-reader-fullscreen-icon d="M14 4h6v6m0-6-7 7M10 20H4v-6m0 6 7-7" />
          </svg>
          <span data-reader-fullscreen-label>Full screen</span>
        </button>
        <button type="button" data-reader-exit>Exit reading mode <span data-reader-exit-hint aria-hidden="true">· Esc</span></button>
      </div>
      <p data-reader-status role="status"></p>
    </div>
    <div data-reader-content></div>
  </div>
</dialog>

<script>
  import '../scripts/summary-reader';
</script>

<style is:global>
  [data-summary-reader] {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: clip;
    border: 0;
    background: white;
    color: #0f172a;
  }
  [data-reader-panel] {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: white;
    scroll-padding-top: 6rem;
  }
  .reader-toolbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    padding: max(0.5rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) 0.5rem max(1rem, env(safe-area-inset-left));
    border-bottom: 1px solid #e2e8f0;
    background: white;
    font-size: 0.875rem;
  }
  .reader-label { color: #64748b; }
  .reader-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem; margin-left: auto; }
  .reader-actions button {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .reader-actions button:not([hidden]) { display: inline-flex; align-items: center; gap: 0.375rem; }
  .reader-actions svg { flex-shrink: 0; }
  .reader-actions button:hover { background: #f1f5f9; }
  .reader-actions button:focus-visible { outline: 2px solid #4f46e5; outline-offset: 2px; }
  .reader-actions button:disabled { opacity: 0.5; cursor: wait; }
  [data-reader-status]:empty { display: none; }
  [data-reader-status] { flex-basis: 100%; color: #475569; }
  [data-reader-content] { max-width: 46rem; margin: 0 auto; padding: 2.5rem 2rem 5rem; }
  [data-reader-content] .prose-post a { max-width: 100%; overflow-wrap: anywhere; }
  [data-reader-content] :is([data-scroll-back-nav], [data-reader-open], article > details, article > nav, article > footer, nav[aria-label="Other resource catalogs"]) { display: none; }
  @media (max-width: 40rem) {
    [data-reader-content] { padding: 2rem 1.25rem 4rem; }
  }
  @media print {
    [data-reader-open] { display: none !important; }
  }
</style>
