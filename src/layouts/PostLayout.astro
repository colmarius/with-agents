---
import BackNav from '@components/BackNav.astro';
import MermaidRenderer from '@components/MermaidRenderer.astro';
import { formatDate } from '@utils';
import Layout from './Layout.astro';

type Props = {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  canonicalPath?: string;
  noindex?: boolean;
};

const {
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  canonicalPath,
  noindex,
} = Astro.props;
const isAgentPost = (tags || []).includes('AI Agents');
const postPath = canonicalPath ?? `/posts/${slug}`;
const shareUrl = new URL(postPath, Astro.site ?? Astro.url.origin).toString();
---

<Layout
	title={title}
	description={description}
	canonicalPath={postPath}
	noindex={noindex}
	ogType="article"
>
	<article class="mx-auto max-w-2xl pb-16">
		<nav class="mb-10" aria-label="Back">
			<BackNav href="/posts" label="Back to Posts" />
		</nav>
		<header class="mb-12 pb-8 border-b border-slate-200">
			<h1 class="text-4xl font-bold leading-tight text-slate-900 mb-4">{title}</h1>
			<p class="text-lg text-slate-500 mb-3 leading-relaxed">{description}</p>
			<p class="text-sm text-slate-600 mb-3">
				Published <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{updatedDate && (
						<> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>
					)}
				</p>
			<div class="flex items-center justify-between gap-4 flex-wrap">
				{tags && tags.length > 0 && (
					<div class="flex gap-2 flex-wrap">
						{tags.map((tag) => (
							<span class="inline-block px-3 py-1 bg-slate-100 text-slate-700 rounded-md text-sm font-medium">{tag}</span>
						))}
					</div>
				)}
				<div class="post-actions">
					<a
						href={`/posts/${slug}/slides`}
						class="post-action"
						aria-label={`View "${title}" as slides`}
					>
						→ View as slides
					</a>
					<button
						type="button"
						class="post-action"
						data-share-button
						data-share-title={title}
						data-share-url={shareUrl}
					>
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M8.7 15.3 15.3 8.7M7 17H5a4 4 0 0 1 0-8h4M17 7h2a4 4 0 1 1 0 8h-4" />
						</svg>
						<span data-share-label>Copy link</span>
					</button>
					<span class="sr-only" aria-live="polite" data-share-status></span>
				</div>
			</div>
		</header>

		<div class="prose-post">
			<slot />
		</div>

		{isAgentPost && (
			<div class="mt-16 border-t border-gray-200 pt-8">
				<p class="text-gray-800 font-light text-lg">
					<span class="text-gray-600">Looking for more resources?</span>
					<a href="/resources/coding-with-agents" class="ml-1 text-indigo-700 hover:text-indigo-500 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2 rounded-sm">
						Visit the Coding with Agents hub →
					</a>
				</p>
			</div>
		)}
	</article>
</Layout>

<MermaidRenderer />

<script>
	const copyLink = async (url: string) => {
		await navigator.clipboard.writeText(url);
	};

	document.querySelectorAll<HTMLButtonElement>('[data-share-button]').forEach((button) => {
		const label = button.querySelector<HTMLElement>('[data-share-label]');
		const status = button.parentElement?.querySelector<HTMLElement>('[data-share-status]');
		const title = button.dataset.shareTitle;
		const url = button.dataset.shareUrl;

		if (!label || !status || !title || !url) return;

		const shareData = { title, url };
		const canShare = typeof navigator.share === 'function'
			&& (typeof navigator.canShare !== 'function' || navigator.canShare(shareData));
		const defaultLabel = canShare ? 'Share' : 'Copy link';
		label.textContent = defaultLabel;

		button.addEventListener('click', async () => {
			button.disabled = true;
			status.textContent = '';

			try {
				if (canShare) {
					await navigator.share(shareData);
					status.textContent = 'Page shared.';
					return;
				}

				await copyLink(url);
				label.textContent = 'Link copied';
				status.textContent = 'Link copied to clipboard.';
				window.setTimeout(() => {
					label.textContent = defaultLabel;
				}, 2000);
			} catch (error) {
				if (error instanceof DOMException && error.name === 'AbortError') return;

				try {
					await copyLink(url);
					label.textContent = 'Link copied';
					status.textContent = 'Sharing was unavailable, so the link was copied.';
					window.setTimeout(() => {
						label.textContent = defaultLabel;
					}, 2000);
				} catch {
					status.textContent = 'Unable to share or copy the link.';
				}
			} finally {
				button.disabled = false;
			}
		});
	});
</script>

<style>
	.post-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
	}

	.post-action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: #374151;
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 0.375rem;
		padding: 0.375rem 0.625rem;
		font-family: inherit;
		line-height: 1.25rem;
		text-decoration: none;
		transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
		white-space: nowrap;
		cursor: pointer;
	}

	.post-action:hover {
		color: #111827;
		background-color: #f9fafb;
		border-color: #d1d5db;
	}

	.post-action:focus-visible {
		outline: 2px solid #3b82f6;
		outline-offset: 2px;
	}

	.post-action:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	.post-action svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.75;
	}

	@media (max-width: 640px) {
		.flex {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.post-actions {
			flex-direction: row;
			align-items: center;
			gap: 0.5rem;
			margin-left: 0;
		}

		h1 {
			font-size: 2rem;
		}
	}
</style>
