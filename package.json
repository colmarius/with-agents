{
  "name": "with-agents",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "astro": "astro",
    "check": "astro check",
    "content:guard": "node .agents/scripts/public-content-guard.mjs",
    "summaries:check": "node .agents/scripts/summary-timestamps.mjs",
    "summaries:fix": "node .agents/scripts/summary-timestamps.mjs --fix",
    "hooks:install": "prek install",
    "youtube:transcript": "node .agents/scripts/save-youtube-transcript.mjs",
    "youtube:library": "node .agents/scripts/youtube-library.mjs",
    "test": "node --test 'src/**/*.test.ts' '.agents/scripts/*.test.mjs'",
    "lint": "biome lint --write .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "7.0.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "clsx": "2.1.1",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@j178/prek": "0.5.4",
    "@types/node": "24.19.0",
    "linkedom": "0.18.13",
    "typescript": "6.0.3",
    "workbox-build": "7.4.1",
    "youtube-transcript-plus": "2.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
